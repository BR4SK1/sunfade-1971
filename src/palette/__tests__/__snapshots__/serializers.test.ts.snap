            "style": {
              "border": "1px solid currentColor"
            }
          }
        ]
      },
      "MuiAlert": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "&.MuiAlert-colorError.MuiAlert-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0d0a09"
            },
            "&.MuiAlert-colorWarning.MuiAlert-filled": {
              "backgroundColor": "#c28a38",
              "color": "#241c17"
            },
            "&.MuiAlert-colorSuccess.MuiAlert-filled": {
              "backgroundColor": "#7f873f",
              "color": "#1f1814"
            },
            "&.MuiAlert-colorInfo.MuiAlert-filled": {
              "backgroundColor": "#66828a",
              "color": "#17120f"
            },
            "&.MuiAlert-standard.MuiAlert-colorError": {
              "backgroundColor": "#f8e9d2",
              "color": "#602e25",
              "& .MuiAlert-icon": {
                "color": "#602e25"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorWarning": {
              "backgroundColor": "#f8e9d2",
              "color": "#593a11",
              "& .MuiAlert-icon": {
                "color": "#593a11"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorSuccess": {
              "backgroundColor": "#f8e9d2",
              "color": "#434820",
              "& .MuiAlert-icon": {
                "color": "#434820"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorInfo": {
              "backgroundColor": "#f8e9d2",
              "color": "#2f484d",
              "& .MuiAlert-icon": {
                "color": "#2f484d"
              }
            }
          }
        }
      },
      "MuiPopover": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiDrawer": {
        "styleOverrides": {
          "paper": {
            "backgroundColor": "#d5b99a",
            "borderColor": "#4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "root": {
            "&.MuiDrawer-modal .MuiDrawer-paper": {
              "border": "1px solid #4c392e"
            },
            "&.MuiDrawer-docked .MuiDrawer-paper": {
              "border": "1px solid #4c392e"
            }
          }
        }
      },
      "MuiDialog": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiSnackbarContent": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#d5b99a",
            "color": "#241c17",
            "border": "1px solid #4c392e"
          }
        }
      },
      "MuiTooltip": {
        "styleOverrides": {
          "tooltip": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid #4c392e",
            "borderRadius": 2
          }
        }
      },
      "MuiInputLabel": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
          }
        }
      },
      "MuiMenuItem": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
          }
        }
      },
      "MuiTableCell": {
        "styleOverrides": {
          "root": {
            "borderBottomColor": "#4c392e"
          }
        }
      }
    }
  },
};

/** Fully created MUI themes for each variant. */
export const sunfadeThemes: Record<SunfadeVariant, Theme> = {
  'dark-soft': createTheme(sunfadeThemeOptions['dark-soft']),
  'dark-medium': createTheme(sunfadeThemeOptions['dark-medium']),
  'dark-hard': createTheme(sunfadeThemeOptions['dark-hard']),
  'light-soft': createTheme(sunfadeThemeOptions['light-soft']),
  'light-medium': createTheme(sunfadeThemeOptions['light-medium']),
  'light-hard': createTheme(sunfadeThemeOptions['light-hard']),
};

/** Returns the theme for a mode/contrast pair, e.g. getSunfadeTheme('light', 'hard'). */
export function getSunfadeTheme(mode: SunfadeMode, contrast: SunfadeContrast): Theme {
  return sunfadeThemes[\`\${mode}-\${contrast}\` as SunfadeVariant];
}

/** The default variant (dark-medium). */
export const sunfadeTheme: Theme = sunfadeThemes[DEFAULT_SUNFADE_VARIANT];

export default sunfadeTheme;
"
