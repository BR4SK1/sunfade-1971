        "fontSize": "1.25rem",
        "lineHeight": 1.26,
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "h6": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.0625rem",
        "lineHeight": 1.28,
        "fontWeight": 500,
        "letterSpacing": "0.01em"
      },
      "subtitle1": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1rem",
        "lineHeight": 1.4,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "subtitle2": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.875rem",
        "lineHeight": 1.45,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "caption": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      },
      "overline": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.75rem",
        "lineHeight": 2,
        "fontWeight": 600,
        "letterSpacing": "0.08em"
      },
      "button": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      }
