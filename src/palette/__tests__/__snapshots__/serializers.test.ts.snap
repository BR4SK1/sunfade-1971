  'light-medium': {
    "palette": {
      "mode": "light",
      "background": {
        "default": "#f8e9d2",
        "paper": "#e6cfb1"
      },
      "text": {
        "primary": "#392b24",
        "secondary": "#4c392e",
        "disabled": "#795a45"
      },
      "primary": {
        "light": "#e58349",
        "lightContrastText": "#241c17",
        "main": "#864c29",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#fff8e9",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#1f1814"
      },
      "secondary": {
        "light": "#392b24",
        "lightContrastText": "#fff8e9",
        "main": "#4c392e",
        "dark": "#624939",
        "darker": "#795a45",
        "contrastText": "#fff8e9",
        "neutralFill": "#4c392e",
        "neutralFillLabel": "#fff8e9"
      },
      "error": {
        "light": "#e4775f",
        "lightContrastText": "#241c17",
        "main": "#8e4636",
        "dark": "#914334",
        "darker": "#602e25",
        "contrastText": "#fff8e9",
        "neutralFill": "#c05a45",
        "neutralFillLabel": "#0d0a09"
      },
      "warning": {
        "light": "#dfa54c",
        "lightContrastText": "#241c17",
        "main": "#755528",
        "dark": "#906222",
        "darker": "#593a11",
        "contrastText": "#fff8e9",
        "neutralFill": "#c28a38",
        "neutralFillLabel": "#241c17"
      },
      "success": {
        "light": "#a1a45b",
        "lightContrastText": "#241c17",
        "main": "#5c5d2f",
        "dark": "#61682f",
        "darker": "#434820",
        "contrastText": "#fff8e9",
        "neutralFill": "#7f873f",
        "neutralFillLabel": "#1f1814"
      },
      "info": {
        "light": "#89a3a4",
        "lightContrastText": "#241c17",
        "main": "#4e5d61",
        "dark": "#49666d",
        "darker": "#2f484d",
        "contrastText": "#fff8e9",
        "neutralFill": "#66828a",
        "neutralFillLabel": "#17120f"
      },
      "orange": {
        "light": "#e58349",
        "lightContrastText": "#241c17",
        "main": "#864c29",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#fff8e9",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#1f1814"
      },
      "terminalHeader": {
        "background": "#4c392e",
        "text": "#fff8e9"
      },
      "frame": "#4c392e",
