                "&:hover": {
                  "backgroundColor": "#392b24",
                  "color": "#fff8e9"
                }
              }
            },
            "&.MuiChip-colorError.MuiChip-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0d0a09",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#241c17"
                }
              }
            },
            "&.MuiChip-colorWarning.MuiChip-filled": {
              "backgroundColor": "#c28a38",
              "color": "#241c17",
              "@media (hover: hover)": {
