      },
      "MuiButtonBase": {
        "styleOverrides": {
          "root": {
            "&.Mui-focusVisible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiIconButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "minWidth": 40,
            "minHeight": 40,
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiTab": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid transparent",
            "borderRadius": 2,
            "color": "#ead3b0",
            "&.Mui-selected": {
              "color": "#111010",
              "backgroundColor": "#d5b991"
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 1
            }
          }
        }
      },
      "MuiOutlinedInput": {
        "styleOverrides": {
          "notchedOutline": {
            "borderWidth": 1,
            "borderColor": "#d5b991"
          },
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&:hover:not(.Mui-focused):not(.Mui-error) .MuiOutlinedInput-notchedOutline": {
              "borderColor": "#d5b991"
            },
            "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
              "borderWidth": 1,
              "borderColor": "#e58349"
            }
          }
        }
      },
      "MuiInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "&::before": {
              "borderBottomColor": "#d5b991"
            },
            "&:hover:not(.Mui-disabled):not(.Mui-error)::before": {
              "borderBottom": "1px solid #d5b991"
            }
          },
          "underline": {
            "&:after": {
              "borderBottomWidth": 1,
              "borderBottomColor": "#e58349"
            }
          }
        }
      },
      "MuiSelect": {
        "styleOverrides": {
          "icon": {
            "color": "#ead3b0"
          }
        }
      },
      "MuiFilledInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "backgroundColor": "#2c2622",
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "&:before, &:after": {
              "display": "none"
            },
            "&:hover": {
              "backgroundColor": "#3e332c"
            },
            "&.Mui-focused": {
              "backgroundColor": "#3e332c",
              "borderColor": "#e58349"
            },
            "&.Mui-disabled": {
              "backgroundColor": "#2c2622"
            }
          }
        }
      },
      "MuiAccordionSummary": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#fff1d6",
            "borderRadius": 2,
            "&.Mui-expanded": {
              "minHeight": 44
            }
          },
          "content": {
            "&.Mui-expanded": {
              "margin": "12px 0"
            }
          },
          "expandIconWrapper": {
            "color": "#ead3b0"
          }
        }
      },
      "MuiAccordion": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #d5b991",
            "boxShadow": "none",
            "&:before": {
              "display": "none"
            }
          }
        }
      },
      "MuiChip": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&.MuiChip-colorPrimary.MuiChip-filled": {
              "backgroundColor": "#c46a35",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorSecondary.MuiChip-filled": {
              "backgroundColor": "#d5b991",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#ead3b0",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorError.MuiChip-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0c0b0b",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorWarning.MuiChip-filled": {
              "backgroundColor": "#c28a38",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorSuccess.MuiChip-filled": {
              "backgroundColor": "#7f873f",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorInfo.MuiChip-filled": {
              "backgroundColor": "#66828a",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#111010"
                }
              }
            }
          }
        },
        "variants": [
          {
            "props": {
              "variant": "outlined"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "primary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "secondary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "error"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "warning"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "success"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "info"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          }
        ]
      },
      "MuiAlert": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "&.MuiAlert-colorError.MuiAlert-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0c0b0b"
            },
            "&.MuiAlert-colorWarning.MuiAlert-filled": {
              "backgroundColor": "#c28a38",
              "color": "#111010"
            },
            "&.MuiAlert-colorSuccess.MuiAlert-filled": {
              "backgroundColor": "#7f873f",
              "color": "#111010"
            },
            "&.MuiAlert-colorInfo.MuiAlert-filled": {
              "backgroundColor": "#66828a",
              "color": "#111010"
            },
            "&.MuiAlert-standard.MuiAlert-colorError": {
              "backgroundColor": "#111010",
              "color": "#e4775f",
              "& .MuiAlert-icon": {
                "color": "#e4775f"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorWarning": {
              "backgroundColor": "#111010",
              "color": "#dfa54c",
              "& .MuiAlert-icon": {
                "color": "#dfa54c"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorSuccess": {
              "backgroundColor": "#111010",
              "color": "#a1a45b",
              "& .MuiAlert-icon": {
                "color": "#a1a45b"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorInfo": {
              "backgroundColor": "#111010",
              "color": "#89a3a4",
              "& .MuiAlert-icon": {
                "color": "#89a3a4"
              }
            }
          }
        }
      },
      "MuiPopover": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiDrawer": {
        "styleOverrides": {
          "paper": {
            "backgroundColor": "#3e332c",
            "borderColor": "#d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "root": {
            "&.MuiDrawer-modal .MuiDrawer-paper": {
              "border": "1px solid #d5b991"
            },
            "&.MuiDrawer-docked .MuiDrawer-paper": {
              "border": "1px solid #d5b991"
            }
          }
        }
      },
      "MuiDialog": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiSnackbarContent": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#3e332c",
            "color": "#fff1d6",
            "border": "1px solid #d5b991"
          }
        }
      },
      "MuiTooltip": {
        "styleOverrides": {
          "tooltip": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid #d5b991",
            "borderRadius": 2
          }
        }
      },
      "MuiInputLabel": {
        "styleOverrides": {
          "root": {
