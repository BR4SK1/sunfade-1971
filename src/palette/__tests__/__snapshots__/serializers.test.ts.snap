      "MuiMenuItem": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
          }
        }
      },
      "MuiTableCell": {
        "styleOverrides": {
          "root": {
            "borderBottomColor": "#d5b991"
          }
        }
      }
    }
  },
  'light-soft': {
    "palette": {
      "mode": "light",
      "background": {
        "default": "#efddc2",
        "paper": "#e6cfb1"
      },
      "text": {
        "primary": "#4c392e",
        "secondary": "#624939",
        "disabled": "#795a45"
      },
      "primary": {
        "light": "#e58349",
        "lightContrastText": "#241c17",
        "main": "#7a513a",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#fff8e9",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#1f1814"
      },
      "secondary": {
        "light": "#392b24",
        "lightContrastText": "#fff8e9",
        "main": "#4c392e",
        "dark": "#624939",
        "darker": "#795a45",
        "contrastText": "#fff8e9",
        "neutralFill": "#4c392e",
        "neutralFillLabel": "#fff8e9"
      },
      "error": {
        "light": "#e4775f",
        "lightContrastText": "#241c17",
        "main": "#7e4f44",
        "dark": "#914334",
        "darker": "#602e25",
        "contrastText": "#fff8e9",
        "neutralFill": "#c05a45",
        "neutralFillLabel": "#0d0a09"
      },
      "warning": {
        "light": "#dfa54c",
        "lightContrastText": "#241c17",
        "main": "#6f5637",
        "dark": "#906222",
        "darker": "#593a11",
        "contrastText": "#fff8e9",
        "neutralFill": "#c28a38",
        "neutralFillLabel": "#241c17"
      },
      "success": {
        "light": "#a1a45b",
        "lightContrastText": "#241c17",
        "main": "#5c5d3c",
        "dark": "#61682f",
        "darker": "#434820",
        "contrastText": "#fff8e9",
        "neutralFill": "#7f873f",
        "neutralFillLabel": "#1f1814"
      },
      "info": {
        "light": "#89a3a4",
        "lightContrastText": "#241c17",
        "main": "#535c5f",
        "dark": "#49666d",
        "darker": "#2f484d",
        "contrastText": "#fff8e9",
        "neutralFill": "#66828a",
        "neutralFillLabel": "#17120f"
      },
      "orange": {
        "light": "#e58349",
        "lightContrastText": "#241c17",
        "main": "#7a513a",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#fff8e9",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#1f1814"
      },
      "terminalHeader": {
        "background": "#4c392e",
        "text": "#fff8e9"
      },
      "frame": "#4c392e",
      "divider": "#4c392e",
      "action": {
        "hover": "#4c392e14",
        "selected": "#4c392e29",
        "disabled": "#795a45",
        "disabledBackground": "#efddc2"
      }
    },
    "shape": {
      "borderRadius": 2
    },
    "typography": {
      "fontFamily": "var(--font-sunfade-caskaydia, \\"CaskaydiaCove Nerd Font\\"), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \\"Liberation Mono\\", monospace",
      "h1": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "2.875rem",
        "lineHeight": 1.08,
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "h2": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "2.125rem",
        "lineHeight": 1.14,
        "fontWeight": 600,
        "letterSpacing": "-0.005em"
      },
      "h3": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.75rem",
        "lineHeight": 1.18,
        "fontWeight": 600,
        "letterSpacing": "0"
      },
      "h4": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.5rem",
        "lineHeight": 1.22,
        "fontWeight": 600,
        "letterSpacing": "0"
      },
      "h5": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.25rem",
        "lineHeight": 1.26,
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "h6": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.0625rem",
        "lineHeight": 1.28,
        "fontWeight": 500,
        "letterSpacing": "0.01em"
      },
      "subtitle1": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1rem",
        "lineHeight": 1.4,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "subtitle2": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.875rem",
        "lineHeight": 1.45,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "caption": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      },
      "overline": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.75rem",
        "lineHeight": 2,
        "fontWeight": 600,
        "letterSpacing": "0.08em"
      },
      "button": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      }
    },
    "components": {
      "MuiCssBaseline": {
        "styleOverrides": {
          "body": {
            "backgroundColor": "#efddc2",
            "color": "#4c392e",
            "backgroundImage": "none"
          },
          "::selection": {
            "backgroundColor": "#89a3a4",
            "color": "#241c17"
          }
        }
      },
      "MuiPaper": {
        "styleOverrides": {
          "root": {
            "backgroundImage": "none",
            "borderColor": "#4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "outlined": {
            "borderWidth": 1
          }
        }
      },
      "MuiCard": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiAppBar": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#4c392e",
            "color": "#fff8e9",
            "border": "1px solid #4c392e"
          }
        },
        "defaultProps": {
          "elevation": 0
        }
      },
      "MuiToggleButton": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#4c392e",
            "borderRadius": 2,
            "minHeight": 40,
            "&.Mui-selected": {
              "backgroundColor": "#4c392e",
              "color": "#fff8e9",
              "&:hover": {
                "backgroundColor": "#4c392e",
                "color": "#fff8e9"
              }
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none",
            "&:active": {
              "boxShadow": "none"
            },
            "minHeight": 40,
            "fontWeight": 600,
            "textTransform": "none",
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          },
          "contained": {
            "boxShadow": "none",
            "&:hover": {
              "boxShadow": "none",
              "@media (hover: none)": {
                "boxShadow": "none"
              }
            },
            "&:active": {
              "boxShadow": "none"
            },
            "&.Mui-focusVisible": {
              "boxShadow": "none"
            },
            "&.Mui-disabled": {
              "boxShadow": "none"
            }
          }
        },
        "variants": [
          {
            "props": {
              "color": "primary"
            },
            "style": {
              "--variant-textColor": "#c46a35",
              "--variant-outlinedColor": "#c46a35",
              "--variant-outlinedBorder": "#c46a35",
              "--variant-containedBg": "#c46a35",
              "--variant-containedColor": "#1f1814"
            }
          },
          {
            "props": {
              "color": "secondary"
            },
            "style": {
              "--variant-textColor": "#4c392e",
              "--variant-outlinedColor": "#4c392e",
              "--variant-outlinedBorder": "#4c392e",
              "--variant-containedBg": "#4c392e",
              "--variant-containedColor": "#fff8e9"
            }
          },
          {
            "props": {
              "color": "error"
            },
            "style": {
              "--variant-textColor": "#c05a45",
              "--variant-outlinedColor": "#c05a45",
              "--variant-outlinedBorder": "#c05a45",
              "--variant-containedBg": "#c05a45",
              "--variant-containedColor": "#0d0a09"
            }
          },
          {
            "props": {
              "color": "warning"
            },
            "style": {
              "--variant-textColor": "#c28a38",
              "--variant-outlinedColor": "#c28a38",
              "--variant-outlinedBorder": "#c28a38",
              "--variant-containedBg": "#c28a38",
              "--variant-containedColor": "#241c17"
            }
          },
          {
            "props": {
              "color": "success"
            },
            "style": {
              "--variant-textColor": "#7f873f",
              "--variant-outlinedColor": "#7f873f",
              "--variant-outlinedBorder": "#7f873f",
              "--variant-containedBg": "#7f873f",
