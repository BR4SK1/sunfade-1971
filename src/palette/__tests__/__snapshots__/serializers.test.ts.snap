              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none",
            "&:active": {
              "boxShadow": "none"
            },
            "minHeight": 40,
            "fontWeight": 600,
            "textTransform": "none",
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          },
          "contained": {
            "boxShadow": "none",
            "&:hover": {
              "boxShadow": "none",
              "@media (hover: none)": {
                "boxShadow": "none"
              }
            },
            "&:active": {
              "boxShadow": "none"
            },
            "&.Mui-focusVisible": {
              "boxShadow": "none"
            },
            "&.Mui-disabled": {
              "boxShadow": "none"
            }
