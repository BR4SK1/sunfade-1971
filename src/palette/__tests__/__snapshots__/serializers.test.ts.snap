      },
      "MuiAppBar": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#4c392e",
            "color": "#fff8e9",
            "border": "1px solid #4c392e"
          }
        },
        "defaultProps": {
          "elevation": 0
        }
      },
      "MuiToggleButton": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#392b24",
            "borderRadius": 2,
            "minHeight": 40,
            "&.Mui-selected": {
              "backgroundColor": "#4c392e",
              "color": "#fff8e9",
              "&:hover": {
                "backgroundColor": "#4c392e",
                "color": "#fff8e9"
              }
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none",
            "&:active": {
              "boxShadow": "none"
            },
            "minHeight": 40,
            "fontWeight": 600,
            "textTransform": "none",
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          },
          "contained": {
            "boxShadow": "none",
            "&:hover": {
              "boxShadow": "none",
              "@media (hover: none)": {
                "boxShadow": "none"
              }
            },
            "&:active": {
              "boxShadow": "none"
            },
            "&.Mui-focusVisible": {
              "boxShadow": "none"
            },
            "&.Mui-disabled": {
              "boxShadow": "none"
            }
          }
        },
        "variants": [
          {
            "props": {
              "color": "primary"
            },
            "style": {
              "--variant-textColor": "#c46a35",
              "--variant-outlinedColor": "#c46a35",
              "--variant-outlinedBorder": "#c46a35",
              "--variant-containedBg": "#c46a35",
