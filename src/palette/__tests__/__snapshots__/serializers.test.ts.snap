              "borderWidth": 1,
              "borderColor": "#e58349"
            }
          }
        }
      },
      "MuiInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "&::before": {
              "borderBottomColor": "#4c392e"
            },
            "&:hover:not(.Mui-disabled):not(.Mui-error)::before": {
              "borderBottom": "1px solid #4c392e"
            }
          },
          "underline": {
            "&:after": {
              "borderBottomWidth": 1,
              "borderBottomColor": "#e58349"
            }
          }
        }
      },
      "MuiSelect": {
        "styleOverrides": {
          "icon": {
            "color": "#4c392e"
          }
        }
      },
      "MuiFilledInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "backgroundColor": "#efddc2",
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "&:before, &:after": {
              "display": "none"
            },
            "&:hover": {
              "backgroundColor": "#e6cfb1"
            },
            "&.Mui-focused": {
              "backgroundColor": "#e6cfb1",
              "borderColor": "#e58349"
            },
            "&.Mui-disabled": {
              "backgroundColor": "#efddc2"
            }
          }
        }
      },
      "MuiAccordionSummary": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#392b24",
            "borderRadius": 2,
            "&.Mui-expanded": {
              "minHeight": 44
            }
          },
          "content": {
            "&.Mui-expanded": {
              "margin": "12px 0"
            }
          },
          "expandIconWrapper": {
            "color": "#4c392e"
          }
        }
      },
      "MuiAccordion": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #4c392e",
            "boxShadow": "none",
