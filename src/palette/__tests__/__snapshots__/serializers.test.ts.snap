            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "warning"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "success"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "info"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "primary"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#241c17",
                  "--variant-outlinedBorder": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "secondary"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#392b24",
                  "color": "#fff8e9",
                  "--variant-outlinedBorder": "#fff8e9"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "error"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#241c17",
                  "--variant-outlinedBorder": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "warning"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
