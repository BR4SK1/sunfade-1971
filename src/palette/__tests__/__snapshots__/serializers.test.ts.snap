                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#241c17",
                  "--variant-outlinedBorder": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "success"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#241c17",
                  "--variant-outlinedBorder": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "info"
            },
            "style": {
              "backgroundColor": "#f8e9d2",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#241c17",
                  "--variant-outlinedBorder": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "inherit"
            },
            "style": {
              "--variant-outlinedBg": "#f8e9d2"
            }
          }
        ]
      },
      "MuiButtonBase": {
        "styleOverrides": {
          "root": {
            "&.Mui-focusVisible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiIconButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "minWidth": 40,
            "minHeight": 40,
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiTab": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid transparent",
            "borderRadius": 2,
            "color": "#624939",
            "&.Mui-selected": {
              "color": "#fff8e9",
              "backgroundColor": "#4c392e"
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 1
            }
          }
        }
      },
      "MuiOutlinedInput": {
        "styleOverrides": {
          "notchedOutline": {
            "borderWidth": 1,
            "borderColor": "#4c392e"
          },
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&:hover:not(.Mui-focused):not(.Mui-error) .MuiOutlinedInput-notchedOutline": {
              "borderColor": "#4c392e"
            },
            "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
              "borderWidth": 1,
              "borderColor": "#e58349"
            }
          }
        }
      },
      "MuiInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "&::before": {
              "borderBottomColor": "#4c392e"
            },
            "&:hover:not(.Mui-disabled):not(.Mui-error)::before": {
              "borderBottom": "1px solid #4c392e"
            }
          },
          "underline": {
            "&:after": {
              "borderBottomWidth": 1,
              "borderBottomColor": "#e58349"
            }
          }
        }
      },
      "MuiSelect": {
        "styleOverrides": {
          "icon": {
            "color": "#624939"
          }
        }
      },
      "MuiFilledInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "backgroundColor": "#efddc2",
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "&:before, &:after": {
              "display": "none"
            },
            "&:hover": {
              "backgroundColor": "#e6cfb1"
            },
            "&.Mui-focused": {
              "backgroundColor": "#e6cfb1",
              "borderColor": "#e58349"
            },
            "&.Mui-disabled": {
              "backgroundColor": "#efddc2"
            }
          }
        }
      },
      "MuiAccordionSummary": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#4c392e",
            "borderRadius": 2,
            "&.Mui-expanded": {
              "minHeight": 44
            }
          },
          "content": {
            "&.Mui-expanded": {
              "margin": "12px 0"
            }
          },
          "expandIconWrapper": {
            "color": "#624939"
          }
        }
      },
      "MuiAccordion": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #4c392e",
            "boxShadow": "none",
            "&:before": {
              "display": "none"
            }
          }
        }
      },
      "MuiChip": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&.MuiChip-colorPrimary.MuiChip-filled": {
              "backgroundColor": "#c46a35",
              "color": "#1f1814",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#241c17"
                }
              }
            },
            "&.MuiChip-colorSecondary.MuiChip-filled": {
              "backgroundColor": "#4c392e",
              "color": "#fff8e9",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#392b24",
                  "color": "#fff8e9"
                }
              }
            },
            "&.MuiChip-colorError.MuiChip-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0d0a09",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#241c17"
                }
              }
            },
            "&.MuiChip-colorWarning.MuiChip-filled": {
              "backgroundColor": "#c28a38",
              "color": "#241c17",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#241c17"
                }
              }
            },
            "&.MuiChip-colorSuccess.MuiChip-filled": {
              "backgroundColor": "#7f873f",
              "color": "#1f1814",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#241c17"
                }
              }
            },
            "&.MuiChip-colorInfo.MuiChip-filled": {
              "backgroundColor": "#66828a",
              "color": "#17120f",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#241c17"
                }
              }
            }
          }
        },
        "variants": [
          {
            "props": {
              "variant": "outlined"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "primary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "secondary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "error"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "warning"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "success"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "info"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          }
        ]
      },
      "MuiAlert": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "&.MuiAlert-colorError.MuiAlert-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0d0a09"
            },
            "&.MuiAlert-colorWarning.MuiAlert-filled": {
              "backgroundColor": "#c28a38",
              "color": "#241c17"
            },
            "&.MuiAlert-colorSuccess.MuiAlert-filled": {
              "backgroundColor": "#7f873f",
              "color": "#1f1814"
            },
            "&.MuiAlert-colorInfo.MuiAlert-filled": {
              "backgroundColor": "#66828a",
              "color": "#17120f"
            },
            "&.MuiAlert-standard.MuiAlert-colorError": {
              "backgroundColor": "#f8e9d2",
              "color": "#602e25",
              "& .MuiAlert-icon": {
                "color": "#602e25"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorWarning": {
              "backgroundColor": "#f8e9d2",
              "color": "#593a11",
              "& .MuiAlert-icon": {
                "color": "#593a11"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorSuccess": {
              "backgroundColor": "#f8e9d2",
              "color": "#434820",
              "& .MuiAlert-icon": {
                "color": "#434820"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorInfo": {
              "backgroundColor": "#f8e9d2",
              "color": "#2f484d",
              "& .MuiAlert-icon": {
                "color": "#2f484d"
              }
            }
          }
        }
      },
      "MuiPopover": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiDrawer": {
        "styleOverrides": {
          "paper": {
            "backgroundColor": "#e6cfb1",
            "borderColor": "#4c392e",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "root": {
            "&.MuiDrawer-modal .MuiDrawer-paper": {
              "border": "1px solid #4c392e"
            },
            "&.MuiDrawer-docked .MuiDrawer-paper": {
              "border": "1px solid #4c392e"
            }
