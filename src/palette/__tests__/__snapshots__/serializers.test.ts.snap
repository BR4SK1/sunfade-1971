        ]
      },
      "MuiButtonBase": {
        "styleOverrides": {
          "root": {
            "&.Mui-focusVisible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiIconButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "minWidth": 40,
            "minHeight": 40,
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiTab": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid transparent",
            "borderRadius": 2,
            "color": "#b99b75",
            "&.Mui-selected": {
              "color": "#111010",
              "backgroundColor": "#d5b991"
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 1
            }
          }
        }
      },
      "MuiOutlinedInput": {
        "styleOverrides": {
          "notchedOutline": {
            "borderWidth": 1,
            "borderColor": "#d5b991"
          },
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&:hover:not(.Mui-focused):not(.Mui-error) .MuiOutlinedInput-notchedOutline": {
              "borderColor": "#d5b991"
            },
            "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
              "borderWidth": 1,
              "borderColor": "#e58349"
            }
          }
        }
      },
      "MuiInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "&::before": {
              "borderBottomColor": "#d5b991"
            },
            "&:hover:not(.Mui-disabled):not(.Mui-error)::before": {
              "borderBottom": "1px solid #d5b991"
            }
          },
          "underline": {
            "&:after": {
              "borderBottomWidth": 1,
              "borderBottomColor": "#e58349"
            }
          }
        }
      },
      "MuiSelect": {
        "styleOverrides": {
          "icon": {
            "color": "#b99b75"
          }
        }
      },
      "MuiFilledInput": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "backgroundColor": "#251f1c",
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "&:before, &:after": {
              "display": "none"
            },
            "&:hover": {
              "backgroundColor": "#2c2622"
            },
            "&.Mui-focused": {
              "backgroundColor": "#2c2622",
              "borderColor": "#e58349"
            },
            "&.Mui-disabled": {
              "backgroundColor": "#251f1c"
            }
          }
        }
      },
      "MuiAccordionSummary": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#d5b991",
            "borderRadius": 2,
            "&.Mui-expanded": {
              "minHeight": 44
            }
          },
          "content": {
            "&.Mui-expanded": {
              "margin": "12px 0"
            }
          },
          "expandIconWrapper": {
            "color": "#b99b75"
          }
        }
      },
      "MuiAccordion": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #d5b991",
            "boxShadow": "none",
            "&:before": {
              "display": "none"
            }
          }
        }
      },
      "MuiChip": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "borderRadius": 2,
            "&.MuiChip-colorPrimary.MuiChip-filled": {
              "backgroundColor": "#c46a35",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorSecondary.MuiChip-filled": {
              "backgroundColor": "#d5b991",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#ead3b0",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorError.MuiChip-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0c0b0b",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorWarning.MuiChip-filled": {
              "backgroundColor": "#c28a38",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorSuccess.MuiChip-filled": {
              "backgroundColor": "#7f873f",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#111010"
                }
              }
            },
            "&.MuiChip-colorInfo.MuiChip-filled": {
              "backgroundColor": "#66828a",
              "color": "#111010",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#111010"
                }
              }
            }
          }
        },
        "variants": [
          {
            "props": {
              "variant": "outlined"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "primary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "secondary"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "error"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "warning"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "success"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "info"
            },
            "style": {
              "border": "1px solid currentColor"
            }
          }
        ]
      },
      "MuiAlert": {
        "styleOverrides": {
          "root": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "&.MuiAlert-colorError.MuiAlert-filled": {
              "backgroundColor": "#c05a45",
              "color": "#0c0b0b"
            },
            "&.MuiAlert-colorWarning.MuiAlert-filled": {
              "backgroundColor": "#c28a38",
              "color": "#111010"
            },
            "&.MuiAlert-colorSuccess.MuiAlert-filled": {
              "backgroundColor": "#7f873f",
              "color": "#111010"
            },
            "&.MuiAlert-colorInfo.MuiAlert-filled": {
              "backgroundColor": "#66828a",
              "color": "#111010"
            },
            "&.MuiAlert-standard.MuiAlert-colorError": {
              "backgroundColor": "#111010",
              "color": "#e4775f",
              "& .MuiAlert-icon": {
                "color": "#e4775f"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorWarning": {
              "backgroundColor": "#111010",
              "color": "#dfa54c",
              "& .MuiAlert-icon": {
                "color": "#dfa54c"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorSuccess": {
              "backgroundColor": "#111010",
              "color": "#a1a45b",
              "& .MuiAlert-icon": {
                "color": "#a1a45b"
              }
            },
            "&.MuiAlert-standard.MuiAlert-colorInfo": {
              "backgroundColor": "#111010",
              "color": "#89a3a4",
              "& .MuiAlert-icon": {
                "color": "#89a3a4"
              }
            }
          }
        }
      },
      "MuiPopover": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiDrawer": {
        "styleOverrides": {
          "paper": {
            "backgroundColor": "#2c2622",
            "borderColor": "#d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "root": {
            "&.MuiDrawer-modal .MuiDrawer-paper": {
              "border": "1px solid #d5b991"
            },
            "&.MuiDrawer-docked .MuiDrawer-paper": {
              "border": "1px solid #d5b991"
            }
          }
        }
      },
      "MuiDialog": {
        "styleOverrides": {
          "paper": {
            "border": "1px solid #d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiSnackbarContent": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#2c2622",
            "color": "#d5b991",
            "border": "1px solid #d5b991"
          }
        }
      },
      "MuiTooltip": {
        "styleOverrides": {
          "tooltip": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "border": "1px solid #d5b991",
            "borderRadius": 2
          }
        }
      },
      "MuiInputLabel": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
          }
        }
      },
      "MuiMenuItem": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
          }
        }
      },
      "MuiTableCell": {
        "styleOverrides": {
          "root": {
            "borderBottomColor": "#d5b991"
          }
        }
      }
    }
  },
  'dark-medium': {
    "palette": {
      "mode": "dark",
      "background": {
        "default": "#1b1816",
        "paper": "#2c2622"
      },
      "text": {
        "primary": "#ead3b0",
        "secondary": "#d5b991",
        "disabled": "#a78762"
      },
      "primary": {
        "light": "#e58349",
        "lightContrastText": "#111010",
        "main": "#ca7946",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#111010",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#111010"
      },
      "secondary": {
        "light": "#ead3b0",
        "lightContrastText": "#111010",
        "main": "#d5b991",
        "dark": "#b99b75",
        "darker": "#a78762",
        "contrastText": "#111010",
        "neutralFill": "#d5b991",
        "neutralFillLabel": "#111010"
      },
      "error": {
        "light": "#e4775f",
        "lightContrastText": "#111010",
        "main": "#cb765f",
        "dark": "#914334",
        "darker": "#602e25",
        "contrastText": "#111010",
        "neutralFill": "#c05a45",
        "neutralFillLabel": "#0c0b0b"
      },
      "warning": {
        "light": "#dfa54c",
        "lightContrastText": "#111010",
        "main": "#c28a38",
        "dark": "#906222",
        "darker": "#593a11",
        "contrastText": "#111010",
        "neutralFill": "#c28a38",
        "neutralFillLabel": "#111010"
      },
      "success": {
        "light": "#a1a45b",
        "lightContrastText": "#111010",
        "main": "#8c924e",
        "dark": "#61682f",
        "darker": "#434820",
        "contrastText": "#111010",
        "neutralFill": "#7f873f",
        "neutralFillLabel": "#111010"
      },
      "info": {
        "light": "#89a3a4",
        "lightContrastText": "#111010",
        "main": "#7a9194",
        "dark": "#49666d",
        "darker": "#2f484d",
        "contrastText": "#111010",
        "neutralFill": "#66828a",
        "neutralFillLabel": "#111010"
      },
      "orange": {
        "light": "#e58349",
        "lightContrastText": "#111010",
        "main": "#ca7946",
        "dark": "#92502b",
        "darker": "#62361f",
        "contrastText": "#111010",
        "neutralFill": "#c46a35",
        "neutralFillLabel": "#111010"
      },
      "terminalHeader": {
        "background": "#d5b991",
        "text": "#111010"
      },
      "frame": "#d5b991",
      "divider": "#d5b991",
      "action": {
        "hover": "#ead3b014",
        "selected": "#ead3b029",
        "disabled": "#a78762",
        "disabledBackground": "#251f1c"
      }
    },
    "shape": {
      "borderRadius": 2
    },
    "typography": {
      "fontFamily": "var(--font-sunfade-caskaydia, \\"CaskaydiaCove Nerd Font\\"), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \\"Liberation Mono\\", monospace",
      "h1": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "2.875rem",
        "lineHeight": 1.08,
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "h2": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "2.125rem",
        "lineHeight": 1.14,
        "fontWeight": 600,
        "letterSpacing": "-0.005em"
      },
      "h3": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.75rem",
        "lineHeight": 1.18,
        "fontWeight": 600,
        "letterSpacing": "0"
      },
      "h4": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.5rem",
        "lineHeight": 1.22,
        "fontWeight": 600,
        "letterSpacing": "0"
      },
      "h5": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.25rem",
        "lineHeight": 1.26,
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "h6": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1.0625rem",
        "lineHeight": 1.28,
        "fontWeight": 500,
        "letterSpacing": "0.01em"
      },
      "subtitle1": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "1rem",
        "lineHeight": 1.4,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "subtitle2": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.875rem",
        "lineHeight": 1.45,
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "caption": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      },
      "overline": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
        "fontSize": "0.75rem",
        "lineHeight": 2,
        "fontWeight": 600,
        "letterSpacing": "0.08em"
      },
      "button": {
        "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
      }
    },
    "components": {
      "MuiCssBaseline": {
        "styleOverrides": {
          "body": {
            "backgroundColor": "#1b1816",
            "color": "#ead3b0",
            "backgroundImage": "none"
          },
          "::selection": {
            "backgroundColor": "#89a3a4",
            "color": "#111010"
          }
        }
      },
      "MuiPaper": {
        "styleOverrides": {
          "root": {
            "backgroundImage": "none",
            "borderColor": "#d5b991",
            "borderRadius": 2,
            "boxShadow": "none"
          },
          "outlined": {
            "borderWidth": 1
          }
        }
      },
      "MuiCard": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none"
          }
        }
      },
      "MuiAppBar": {
        "styleOverrides": {
          "root": {
            "backgroundColor": "#d5b991",
            "color": "#111010",
            "border": "1px solid #d5b991"
          }
        },
        "defaultProps": {
          "elevation": 0
        }
      },
      "MuiToggleButton": {
        "styleOverrides": {
          "root": {
            "fontFamily": "var(--font-sunfade-montserrat, \\"Montserrat\\"), \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif",
            "color": "#ead3b0",
            "borderRadius": 2,
            "minHeight": 40,
            "&.Mui-selected": {
              "backgroundColor": "#d5b991",
              "color": "#111010",
              "&:hover": {
                "backgroundColor": "#d5b991",
                "color": "#111010"
              }
            },
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          }
        }
      },
      "MuiButton": {
        "styleOverrides": {
          "root": {
            "borderRadius": 2,
            "boxShadow": "none",
            "&:active": {
              "boxShadow": "none"
            },
            "minHeight": 40,
            "fontWeight": 600,
            "textTransform": "none",
            "&:focus-visible": {
              "outline": "1px solid #e58349",
              "outlineOffset": 2
            }
          },
          "contained": {
            "boxShadow": "none",
            "&:hover": {
              "boxShadow": "none",
              "@media (hover: none)": {
                "boxShadow": "none"
              }
            },
            "&:active": {
              "boxShadow": "none"
            },
            "&.Mui-focusVisible": {
              "boxShadow": "none"
            },
            "&.Mui-disabled": {
              "boxShadow": "none"
            }
          }
        },
        "variants": [
          {
            "props": {
              "color": "primary"
            },
            "style": {
              "--variant-textColor": "#c46a35",
              "--variant-outlinedColor": "#c46a35",
              "--variant-outlinedBorder": "#c46a35",
              "--variant-containedBg": "#c46a35",
              "--variant-containedColor": "#111010"
            }
          },
          {
            "props": {
              "color": "secondary"
            },
            "style": {
              "--variant-textColor": "#d5b991",
              "--variant-outlinedColor": "#d5b991",
              "--variant-outlinedBorder": "#d5b991",
              "--variant-containedBg": "#d5b991",
              "--variant-containedColor": "#111010"
            }
          },
          {
            "props": {
              "color": "error"
            },
            "style": {
              "--variant-textColor": "#c05a45",
              "--variant-outlinedColor": "#c05a45",
              "--variant-outlinedBorder": "#c05a45",
              "--variant-containedBg": "#c05a45",
              "--variant-containedColor": "#0c0b0b"
            }
          },
          {
            "props": {
              "color": "warning"
            },
            "style": {
              "--variant-textColor": "#c28a38",
              "--variant-outlinedColor": "#c28a38",
              "--variant-outlinedBorder": "#c28a38",
              "--variant-containedBg": "#c28a38",
              "--variant-containedColor": "#111010"
            }
          },
          {
            "props": {
              "color": "success"
            },
            "style": {
              "--variant-textColor": "#7f873f",
              "--variant-outlinedColor": "#7f873f",
              "--variant-outlinedBorder": "#7f873f",
              "--variant-containedBg": "#7f873f",
              "--variant-containedColor": "#111010"
            }
          },
          {
            "props": {
              "color": "info"
            },
            "style": {
              "--variant-textColor": "#66828a",
              "--variant-outlinedColor": "#66828a",
              "--variant-outlinedBorder": "#66828a",
              "--variant-containedBg": "#66828a",
              "--variant-containedColor": "#111010"
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "primary"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "secondary"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#ead3b0",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "error"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "warning"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "success"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "info"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "primary"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "secondary"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#ead3b0",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "error"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e4775f",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "warning"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#dfa54c",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "success"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#a1a45b",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "info"
            },
            "style": {
              "backgroundColor": "#1b1816",
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#89a3a4",
                  "color": "#111010",
                  "--variant-outlinedBorder": "#111010"
                }
              }
            }
          },
          {
            "props": {
              "variant": "outlined",
              "color": "inherit"
            },
            "style": {
              "--variant-outlinedBg": "#1b1816"
