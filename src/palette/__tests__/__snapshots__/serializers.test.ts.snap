    "components": {
      "MuiCssBaseline": {
        "styleOverrides": {
          "body": {
            "backgroundColor": "#f8e9d2",
            "color": "#392b24",
            "backgroundImage": "none"
          },
          "::selection": {
            "backgroundColor": "#89a3a4",
            "color": "#241c17"
          }
        }
      },
      "MuiPaper": {
        "styleOverrides": {
          "root": {
