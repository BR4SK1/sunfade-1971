              "--variant-textColor": "#66828a",
              "--variant-outlinedColor": "#66828a",
              "--variant-outlinedBorder": "#66828a",
              "--variant-containedBg": "#66828a",
              "--variant-containedColor": "#17120f"
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "primary"
            },
            "style": {
              "@media (hover: hover)": {
                "&:hover": {
                  "backgroundColor": "#e58349",
                  "color": "#241c17"
                }
              }
            }
          },
          {
            "props": {
              "variant": "contained",
              "color": "secondary"
            },
            "style": {
