{
  "name": "sunfade-1971",
  "version": "1.0.0",
  "description": "A warm, retro-inspired color palette playground",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 1971",
    "save-server": "node src/scripts/save-defaults-server.mjs",
    "build:mui": "vite build --ssr src/scripts/build-mui-theme.ts --outDir .mui-build --emptyOutDir && node .mui-build/build-mui-theme.js && rm -rf .mui-build",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "color-palette",
    "retro",
    "theme",
    "react",
    "nextjs"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0"
  }
}
